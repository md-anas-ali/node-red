# Runtime data — Node-RED's live state must never be committed.
# This is what /data maps to inside the container; if you ever run
# Node-RED locally outside Docker, this is where it would land.
data/
flows.json
flows_cred.json
.config.runtime.json
.config.nodes.json
.config.users.json
.config.projects.json

# Local secrets — never commit real credentials. Copy .env.example to
# .env for local testing; .env itself stays untracked.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
